# ──────────────────────────────────────────────────────────────
# Azure OpenAI — Chat (GPT-4o-mini)
# ──────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY_CHAT=your-azure-openai-chat-api-key
AZURE_OPENAI_ENDPOINT_CHAT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# ──────────────────────────────────────────────────────────────
# Azure OpenAI — Embeddings (text-embedding-3-small)
# ──────────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY_Embedding=your-azure-openai-embedding-api-key
AZURE_OPENAI_ENDPOINT_Embedding=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION_Embedding=2024-12-01-preview
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-3-small

# ──────────────────────────────────────────────────────────────
# Azure OpenAI — TTS / STT (optional, falls back to chat key)
# ──────────────────────────────────────────────────────────────
# AZURE_OPENAI_ENDPOINT_TTS=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY_TTS=your-tts-api-key
# AZURE_OPENAI_TTS_DEPLOYMENT=tts
# AZURE_OPENAI_API_VERSION_TTS=2024-12-01-preview
# AZURE_OPENAI_ENDPOINT_STT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY_STT=your-stt-api-key
# AZURE_OPENAI_STT_DEPLOYMENT=whisper
# AZURE_OPENAI_API_VERSION_STT=2024-12-01-preview

# ──────────────────────────────────────────────────────────────
# Database (MySQL via PyMySQL)
# ──────────────────────────────────────────────────────────────
VTA_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/vta_database_system

# ──────────────────────────────────────────────────────────────
# Application secrets
# ──────────────────────────────────────────────────────────────
VTA_SECRET_KEY=generate-a-random-secret-key-here

# ──────────────────────────────────────────────────────────────
# Azure Communication Services (OTP emails)
# ──────────────────────────────────────────────────────────────
VTA_EMAIL_CONNECTION_STR=endpoint=https://your-comm-service.communication.azure.com/;accesskey=your-access-key
VTA_FROM_EMAIL=DoNotReply@your-azure-comm-domain.azurecomm.net

# ──────────────────────────────────────────────────────────────
# Paths (defaults are usually fine)
# ──────────────────────────────────────────────────────────────
VTA_INDEX_DIR=./index
# VTA_DATA_DIR=./data

# ──────────────────────────────────────────────────────────────
# Azure Blob Storage — persistent index storage (optional)
# ──────────────────────────────────────────────────────────────
# VTA_BLOB_CONNECTION_STR=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...
# VTA_BLOB_CONTAINER=gvc-indexes
